<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Texto que va arriba de cada campo -->
    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/negro</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Campo para escribir con borde morado -->
    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/borde_morado</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Cuadro de color para cada materia -->
    <style name="Materia">
        <item name="android:layout_width">140dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
